{
  "name": "commander-flash",
  "displayName": "Commander Flash (unofficial)",
  "description": "Flash, erase and open a serial console on Silicon Labs boards from VS Code, using Simplicity Commander. No Simplicity Studio project needed.",
  "version": "0.3.1",
  "publisher": "CheapandLa-ZInc",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1c2a5c",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "silicon labs",
    "efr32",
    "commander",
    "flash",
    "embedded"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onView:commanderFlash.devices",
    "onView:commanderFlash.explorerBoards",
    "workspaceContains:**/cmake_gcc/CMakePresets.json"
  ],
  "contributes": {
    "views": {
      "commanderFlash": [
        {
          "id": "commanderFlash.devices",
          "name": "Boards"
        }
      ],
      "explorer": [
        {
          "id": "commanderFlash.explorerBoards",
          "name": "Silicon Labs Boards",
          "icon": "$(circuit-board)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "commanderFlash.devices",
        "contents": "Simplicity Commander wasn't found.\n[Install Commander](command:commanderFlash.installCommander)\nAlready have it somewhere else?\n[Set Commander path](command:commanderFlash.setPath)",
        "when": "commanderFlash.state == noCommander"
      },
      {
        "view": "commanderFlash.explorerBoards",
        "contents": "Simplicity Commander wasn't found.\n[Install Commander](command:commanderFlash.installCommander)\nAlready have it somewhere else?\n[Set Commander path](command:commanderFlash.setPath)",
        "when": "commanderFlash.state == noCommander"
      },
      {
        "view": "commanderFlash.devices",
        "contents": "No boards connected. Plug in a board with a USB data cable.\n[Refresh](command:commanderFlash.refresh)\nNeed firmware from a repo?\n[Clone a repository](command:git.clone)",
        "when": "commanderFlash.state == noBoards"
      },
      {
        "view": "commanderFlash.explorerBoards",
        "contents": "No boards connected. Plug in a board with a USB data cable.\n[Refresh](command:commanderFlash.refresh)\nNeed firmware from a repo?\n[Clone a repository](command:git.clone)",
        "when": "commanderFlash.state == noBoards"
      }
    ],
    "commands": [
      {
        "command": "commanderFlash.refresh",
        "title": "Refresh",
        "category": "Commander Flash",
        "icon": "$(refresh)"
      },
      {
        "command": "commanderFlash.setPath",
        "title": "Set Commander Path…",
        "category": "Commander Flash"
      },
      {
        "command": "commanderFlash.installCommander",
        "title": "Install Simplicity Commander…",
        "category": "Commander Flash"
      },
      {
        "command": "commanderFlash.build",
        "title": "Build Project",
        "category": "Commander Flash",
        "icon": "$(tools)"
      },
      {
        "command": "commanderFlash.debug",
        "title": "Debug…",
        "category": "Commander Flash",
        "icon": "$(debug-alt)"
      },
      {
        "command": "commanderFlash.flash",
        "title": "Flash…",
        "category": "Commander Flash",
        "icon": "$(zap)"
      },
      {
        "command": "commanderFlash.flashFile",
        "title": "Flash to Board…",
        "category": "Commander Flash"
      },
      {
        "command": "commanderFlash.console",
        "title": "Open Console",
        "category": "Commander Flash",
        "icon": "$(terminal)"
      },
      {
        "command": "commanderFlash.checkBootloader",
        "title": "Check Bootloader",
        "category": "Commander Flash"
      },
      {
        "command": "commanderFlash.installBootloader",
        "title": "Install Bootloader",
        "category": "Commander Flash"
      },
      {
        "command": "commanderFlash.erase",
        "title": "Erase Board…",
        "category": "Commander Flash"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "commanderFlash.build",
          "when": "view =~ /^commanderFlash\\.(devices|explorerBoards)$/",
          "group": "navigation@0"
        },
        {
          "command": "commanderFlash.refresh",
          "when": "view =~ /^commanderFlash\\.(devices|explorerBoards)$/",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "commanderFlash.flash",
          "when": "view =~ /^commanderFlash\\.(devices|explorerBoards)$/ && viewItem == board",
          "group": "inline@0"
        },
        {
          "command": "commanderFlash.debug",
          "when": "view =~ /^commanderFlash\\.(devices|explorerBoards)$/ && viewItem == board",
          "group": "inline@1"
        },
        {
          "command": "commanderFlash.console",
          "when": "view =~ /^commanderFlash\\.(devices|explorerBoards)$/ && viewItem == board",
          "group": "inline@2"
        },
        {
          "command": "commanderFlash.flash",
          "when": "view =~ /^commanderFlash\\.(devices|explorerBoards)$/ && viewItem == board",
          "group": "1_run@0"
        },
        {
          "command": "commanderFlash.debug",
          "when": "view =~ /^commanderFlash\\.(devices|explorerBoards)$/ && viewItem == board",
          "group": "1_run@1"
        },
        {
          "command": "commanderFlash.console",
          "when": "view =~ /^commanderFlash\\.(devices|explorerBoards)$/ && viewItem == board",
          "group": "1_run@2"
        },
        {
          "command": "commanderFlash.checkBootloader",
          "when": "view =~ /^commanderFlash\\.(devices|explorerBoards)$/ && viewItem == board",
          "group": "2_bootloader@0"
        },
        {
          "command": "commanderFlash.installBootloader",
          "when": "view =~ /^commanderFlash\\.(devices|explorerBoards)$/ && viewItem == board",
          "group": "2_bootloader@1"
        },
        {
          "command": "commanderFlash.erase",
          "when": "view =~ /^commanderFlash\\.(devices|explorerBoards)$/ && viewItem == board",
          "group": "9_danger@0"
        }
      ],
      "explorer/context": [
        {
          "command": "commanderFlash.flashFile",
          "when": "resourceExtname =~ /^\\.(hex|s37)$/i",
          "group": "navigation@99"
        }
      ],
      "commandPalette": [
        {
          "command": "commanderFlash.flashFile",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Commander Flash",
      "properties": {
        "commanderFlash.path": {
          "type": "string",
          "default": "",
          "description": "Full path to the Simplicity Commander executable. Leave empty to search PATH and the usual install locations."
        },
        "commanderFlash.autoRefreshSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "How often to refresh the board list, in seconds. 0 turns auto-refresh off."
        },
        "commanderFlash.bootloaders": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Bootloader image per board ID, e.g. `{ \"2601B\": \"/path/to/bootloader.s37\" }`. Adds to or overrides the bundled ones (`2601B`, `2703A`)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "commanderFlash",
          "title": "Commander Flash",
          "icon": "$(zap)"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "tsc -p . && node --test out/test/*.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.2.0",
    "ovsx": "^1.3.0",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kfezer/commander-flash.git"
  }
}
